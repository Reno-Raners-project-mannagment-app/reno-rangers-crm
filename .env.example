# Copy this file to .env and fill in the values for your environment.

# Postgres connection used by Prisma at runtime (queries/transactions).
# In production this is Supabase's *transaction* pooler (port 6543,
# ?pgbouncer=true&connection_limit=1) — see the comment on the `db`
# datasource in prisma/schema.prisma for why. For local development, any
# reachable Postgres instance works, e.g.:
# postgresql://<user>:<password>@localhost:5432/reno_rangers_crm?schema=public
DATABASE_URL=""

# Postgres connection Prisma uses for migrations (`prisma migrate ...`).
# In production this is Supabase's *session* pooler (port 5432), since
# migrations don't go through pgbouncer. Locally this can be the same
# value as DATABASE_URL.
DIRECT_URL=""

# Secret used to sign session JWTs (src/lib/auth.ts, src/middleware.ts).
# Falls back to an insecure dev-only default if unset — always set a
# random value in production.
SESSION_SECRET=""

# Supabase project URL and anon key, used server-side to upload/delete
# files in Supabase Storage (src/lib/supabaseStorage.ts). Only required
# for the document/photo upload features.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Name of the Supabase Storage bucket used for uploads. Defaults to
# "reno-rangers-files" if unset.
SUPABASE_STORAGE_BUCKET=""
